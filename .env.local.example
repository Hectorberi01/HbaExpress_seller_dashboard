# =====================================================================
#  Seller_MP_Next — variables d'environnement (copier en .env.local)
#     cp .env.local.example .env.local
# =====================================================================

# URL de base du BFF Vendeur (côté SERVEUR Next uniquement — jamais exposée au navigateur).
# Staging : https://seller.marketplace-staging.hba-marketplace.fr
# Prod    : https://seller.hba-express.org
# Backend local : http://localhost:8081 (ou l'hôte du bff-seller)
SELLER_BFF_URL=https://seller.marketplace-staging.hba-marketplace.fr

# Secret de chiffrement de la session (cookie httpOnly qui garde les jetons côté serveur).
# Générez-en un : openssl rand -base64 32
# ⚠️ En production, l'application REFUSE de servir si ce secret est absent, fait moins de
#    32 caractères, ou est resté sur la valeur par défaut.
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_32

# Optionnel : forcer le cookie de session en Secure (défaut : true hors développement).
# SESSION_COOKIE_SECURE=false
